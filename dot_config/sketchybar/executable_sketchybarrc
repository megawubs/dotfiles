#!/bin/bash
# SketchyBar config — Catppuccin Mocha
# Requires: brew install --HEAD FelixKratz/formulae/sketchybar

PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

# ── Catppuccin Mocha palette ──────────────────────────────────────────────────
BASE=0xff1e1e2e
SURFACE0=0xff313244
TEXT=0xffcdd6f4
SUBTEXT1=0xffbac2de
MAUVE=0xffcba6f7
BLUE=0xff89b4fa
OVERLAY0=0xff6c7086

# ── Bar ───────────────────────────────────────────────────────────────────────
sketchybar --bar \
  height=28 \
  blur_radius=0 \
  position=top \
  sticky=on \
  topmost=window \
  padding_left=8 \
  padding_right=8 \
  color=$BASE

# ── Defaults ──────────────────────────────────────────────────────────────────
sketchybar --default \
  icon.font="JetBrainsMono Nerd Font Mono:Bold:13.0" \
  label.font="JetBrainsMono Nerd Font Mono:Bold:13.0" \
  icon.color=$TEXT \
  label.color=$TEXT \
  padding_left=4 \
  padding_right=4 \
  label.padding_left=4 \
  label.padding_right=4

# ── Clock + Date ──────────────────────────────────────────────────────────────
sketchybar --add item clock right \
           --set clock \
             update_freq=10 \
             label.color=$TEXT \
             script="$PLUGIN_DIR/clock.sh"

sketchybar --add item date right \
           --set date \
             update_freq=60 \
             label.color=$SUBTEXT1 \
             script="$PLUGIN_DIR/date.sh"

# ── Battery ───────────────────────────────────────────────────────────────────
sketchybar --add item battery right \
           --set battery \
             update_freq=60 \
             label.color=$TEXT \
             script="$PLUGIN_DIR/battery.sh"

# ── CPU ───────────────────────────────────────────────────────────────────────
sketchybar --add item cpu right \
           --set cpu \
             update_freq=5 \
             label.color=$TEXT \
             script="$PLUGIN_DIR/cpu.sh"

# ── Memory ────────────────────────────────────────────────────────────────────
sketchybar --add item memory right \
           --set memory \
             update_freq=10 \
             label.color=$TEXT \
             script="$PLUGIN_DIR/memory.sh"

# ── Spotify ───────────────────────────────────────────────────────────────────
sketchybar --add item spotify left \
           --set spotify \
             update_freq=5 \
             icon="" \
             icon.font="JetBrainsMono Nerd Font Mono:Bold:16.0" \
             icon.color=$MAUVE \
             label.color=$MAUVE \
             script="$PLUGIN_DIR/spotify.sh"

# ── Calendar ──────────────────────────────────────────────────────────────────
sketchybar --add item calendar left \
           --set calendar \
             update_freq=10 \
             icon="" \
             icon.font="JetBrainsMono Nerd Font Mono:Bold:16.0" \
             icon.color=$BLUE \
             script="$PLUGIN_DIR/calendar.sh"

# ── Finalise ──────────────────────────────────────────────────────────────────
sketchybar --update
